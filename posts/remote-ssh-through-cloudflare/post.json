    {
      "type": "paragraph",
      "text": "Create SSH Config File"
    },
    {
      "type": "code",
      "language": "Bash",
      "code": "mkdir -p ~/.ssh\ntouch ~/.ssh/config\nchmod 700 ~/.ssh\nchmod 600 ~/.ssh/config\nnano ~/.ssh/config"
    },
    {
      "type": "paragraph",
      "text": "Past and Config code below to your Domain"
    },
    {
      "type": "code",
      "language": "Bash",
      "code": "Host ssh.<your domain>\nUser <your user name>\nProxyCommand cloudflared access ssh --hostname %h"
    },
    {
      "type": "paragraph",
      "text": "Sign in using command below"
    },
    {
      "type": "image",
      "url": "clientAuth.webp",
      "caption": ""
    },
    {
      "type": "code",
      "language": "Bash",
      "code": "cloudflared access ssh --hostname ssh.<your domain.com>"
    },
